PORT=3000
# Run emulator without UI window (true/false)
EMULATOR_HEADLESS=false
# Android emulator GPU mode: auto, host, swiftshader, swangle, software, lavapipe
EMULATOR_GPU=auto
# Optional comma-separated DNS servers the emulator will use
EMULATOR_DNS=8.8.8.8,1.1.1.1
# Route emulator traffic through a local router that sends CDN hosts direct
# and everything else through the device proxy (false = use the proxy as-is)
EMULATOR_PROXY_ROUTER=true
# Extra hosts (comma-separated, * wildcards) emulators reach without the
# proxy. These are image-only hosts: Maps place photos, Street View, satellite tiles
EMULATOR_PROXY_BYPASS_EXTRA=lh*.googleusercontent.com,*.ggpht.com,streetviewpixels-pa.googleapis.com,khms*.google.com,maps.gstatic.com
# Android SDK location (default /root/Android/Sdk)
# ANDROID_SDK_ROOT=/usr/lib/android-sdk
EMULATOR_HEADLESS=false
