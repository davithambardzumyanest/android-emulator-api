PORT=3000
# Run emulator without UI window (true/false)
EMULATOR_HEADLESS=false
# Android emulator GPU mode: auto, host, swiftshader, swangle, software, lavapipe
EMULATOR_GPU=auto
# Emulator acceleration mode: on, off, auto
EMULATOR_ACCEL=auto
# Emulator memory in MB (e.g. 1536)
EMULATOR_MEMORY_MB=1536
# Emulator CPU cores
EMULATOR_CORES=2
# Advanced toggles (defaults chosen to match the minimal "works everywhere" command)
# If false, emulator chooses default port (usually 5554)
EMULATOR_USE_PORT_FLAG=true
# Passing proxy directly to emulator can cause instability on some hosts; default off.
EMULATOR_USE_HTTP_PROXY_FLAG=false
# Extra flags that may change behavior; keep off unless needed
EMULATOR_NETFAST=false
EMULATOR_READ_ONLY=false
EMULATOR_DISABLE_CAMERAS=false
# Optional: force QEMU CPU model (helps on hosts missing AES). Example: qemu64
# You can also disable features explicitly (recommended on TCG / no-KVM hosts):
# EMULATOR_QEMU_CPU=qemu64,-avx,-f16c
# Optional comma-separated DNS servers the emulator will use
EMULATOR_DNS=8.8.8.8,1.1.1.1
