# ---- Server -----------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Bearer token required on every endpoint except / and /health.
# Leave empty to disable auth (the API can run adb — do not expose it unauthenticated).
API_TOKEN=
# Comma-separated origins, or * for any.
CORS_ORIGIN=*
# POST /devices/:id/adb runs arbitrary adb subcommands. Off unless you need it.
ALLOW_RAW_ADB=false
# Stop emulators when the API exits. Off by default so a deploy or pm2 restart
# does not end live sessions (emulators run detached and can be re-adopted).
CLEANUP_ON_EXIT=false

# ---- Android SDK ------------------------------------------------------------
# Auto-detected from ANDROID_SDK_ROOT/ANDROID_HOME, the `emulator` binary on
# PATH, then the usual install locations. Set only to override.
# ANDROID_SDK_ROOT=/usr/lib/android-sdk

# ---- Emulator ---------------------------------------------------------------
EMULATOR_HEADLESS=false
# auto, host, swiftshader_indirect, swangle_indirect, software
EMULATOR_GPU=swiftshader_indirect
# Explicit RAM in MB. Unset = 4096 (or the profile's RAM if
# EMULATOR_MEMORY_FROM_PROFILE=true). Always capped to fit host memory.
# EMULATOR_MEMORY_MB=4096
# Use the device profile's real RAM (e.g. 8 GB for a Pixel 5). More realistic,
# but several emulators at that size will saturate a shared host.
EMULATOR_MEMORY_FROM_PROFILE=false
EMULATOR_CORES=4
# Boot from the AVD snapshot: seconds instead of a cold boot.
EMULATOR_QUICK_BOOT=true
# Only needed to run several instances of the SAME AVD. It also prevents
# snapshots being saved, which disables quick boot.
EMULATOR_READ_ONLY=false
# Force a clean data partition on every boot (slow — a cold boot every time).
EMULATOR_WIPE_DATA=false
EMULATOR_BOOT_TIMEOUT_MS=300000
# lte = shaped like a real mobile link; fast = unthrottled emulator default.
EMULATOR_NET_PROFILE=lte
EMULATOR_AUDIO=false
# Also send a $GPRMC sentence with each GPS fix. Off by default: emulator 36.x
# accepts `geo nmea` but ignores it, so it is a wasted round trip per fix.
EMULATOR_GPS_NMEA=false
# Unset = use the AVD's own camera config (virtualscene back, emulated front).
# EMULATOR_CAMERA=
EMULATOR_DNS=

# ---- Device realism ---------------------------------------------------------
# pixel_5 | pixel_7 | pixel_6a | galaxy_s21 | galaxy_a54  (GET /profiles)
DEVICE_PROFILE=pixel_5
# Left unset on purpose: a timezone/locale that disagrees with the coordinates
# you inject is worse than the image's own. Set to match your GPS region.
# DEVICE_LOCALE=en-US
# DEVICE_TIMEZONE=America/New_York
DEVICE_BATTERY_LEVEL=87
# Screen timeout. The device must not sleep: a dark screen makes every
# uiautomator query fail with "null root node". Default 24h.
DEVICE_SCREEN_OFF_TIMEOUT_MS=86400000
# Real phones animate. Enable only to trade realism for automation speed.
DEVICE_DISABLE_ANIMATIONS=false
# Rewrite the AVD's config.ini from the profile before booting.
DEVICE_APPLY_PROFILE=true
# Boot with a writable /system so build.prop can be patched (see README).
DEVICE_WRITABLE_SYSTEM=false
# Use only the injected GPS fix. Android's fused provider otherwise blends in
# network (Wi-Fi/cell/IP) location, which disagrees with the injected position
# on a proxied device - and apps then route from the wrong origin.
DEVICE_GPS_ONLY=true
# Wi-Fi feeds the network location provider; a phone navigating is on mobile data.
DEVICE_WIFI=false

# ---- adb --------------------------------------------------------------------
ADB_TIMEOUT_MS=30000
# Reuse a fresh UI dump across calls within this window.
ADB_UI_CACHE_MS=400

# ---- Navigation -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
