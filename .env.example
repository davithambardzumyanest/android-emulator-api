PORT=3000
LOG_LEVEL=info
GOOGLE_MAPS_API_KEY=

# --- Emulator resource tuning ---------------------------------------------
# Run emulator without a UI window. On a server this should stay true: a
# visible window adds a whole compositing path on top of software rendering.
EMULATOR_HEADLESS=true

# GPU mode: swiftshader_indirect, auto, host, swangle, software, off.
# 'auto' probes for a GPU, fails on a headless box, and falls back to software
# anyway - naming the software path directly skips the probe.
EMULATOR_GPU=swiftshader_indirect

# RAM (MB) and vCPU count per emulator. Leave unset/0 to inherit the AVD's own
# config.ini, which is normally already sized for the host. Setting these can
# only raise usage above what the AVD asked for.
EMULATOR_MEMORY_MB=
EMULATOR_CORES=

# Ceilings applied to whatever the AVD asks for. Only ever lower what
# config.ini requests, never raise it.
#
# Sized for the deployed host: 8 vCPU / 62 GB running about two devices at a
# time. At that concurrency the AVDs' own 8192MB/4-core request fits (two
# devices is ~17GB of 62GB), so these are set not to clamp it. The old 2048/2
# pair was written for a 15GB box and six devices; on this host it only
# starved the emulators. Lower these if you raise MAX_EMULATORS.
EMULATOR_MAX_MEMORY_MB=8192
EMULATOR_MAX_CORES=4

# Optional display override, "WIDTHxHEIGHT". Fewer pixels means less software
# rasterising per frame and smaller screencap payloads.
EMULATOR_RESOLUTION=

# -read-only gives each boot a throwaway data overlay and lets several devices
# share one AVD, so a blanket -wipe-data only forces a redundant first boot.
EMULATOR_READ_ONLY=true
EMULATOR_WIPE_DATA=false
EMULATOR_COLD_BOOT=true

# Apply low-resource settings (animations off, etc.) once the device boots.
EMULATOR_TUNE_AFTER_BOOT=true
EMULATOR_BOOT_TIMEOUT_MS=300000

# Admission control. Starting more emulators than fit in RAM pushes the host
# into swap, which costs far more than the extra device is worth.
#
# The client runs two devices steadily; the third slot is headroom for the
# overlap when it registers a replacement before releasing the one it is done
# with, which would otherwise be a 429. EMULATOR_ASSUMED_MB tracks
# EMULATOR_MAX_MEMORY_MB: measured qemu RSS lands ~500MB above what -memory
# grants, so raise both together.
MAX_EMULATORS=3
HOST_RESERVED_MB=4096
EMULATOR_ASSUMED_MB=8704

# --- Device lifecycle -----------------------------------------------------
# A client hands a device back with DELETE /devices/:id (or POST
# /devices/:id/release). The sweep below is only the backstop for devices it
# walks away from instead.
#
# Retire a device after this long with no request naming it. Every
# device-scoped route bumps its last-used stamp, so a device driving a campaign
# is never idle however long the campaign runs. 0 disables the idle sweep.
DEVICE_MAX_IDLE_MS=900000

# Absolute cap on a device's life, from registration, ignoring activity. Keep
# this at 0. The 1h version of this rule is what tore down healthy devices in
# the middle of an active drive - being busy does not make a device younger.
# Set it only as a backstop against a client that keeps touching a device it
# can no longer actually use.
DEVICE_MAX_AGE_MS=0

DEVICE_SWEEP_INTERVAL_MS=60000

# With EMULATOR_READ_ONLY=false one AVD backs exactly one emulator, so a
# register that names no AVD has to be given a free one or it races whatever is
# already running. An AVD the caller names is never substituted - the AVDs
# differ in which Google account is signed in - so that case still returns 409,
# listing which AVDs are free.
AVD_AUTO_PICK=true

# --- Cleanup safety -------------------------------------------------------
# POST /cleanup tears down every running emulator. The endpoint is
# unauthenticated, and a cold boot takes ~90s, so anything polling it on a
# ~60s timer destroys devices faster than they can come up. With this on, a
# bare POST /cleanup reports what it would kill and changes nothing; the real
# sweep needs POST /cleanup?force=true.
CLEANUP_REQUIRE_FORCE=true

# Set to this API's PM2 process name to have a forced /cleanup also restart the
# API. Leave EMPTY unless you want that restart - it is not needed for cleanup
# to work, and combined with a polling caller it restarts the API on a loop.
PM2_APP_NAME=

# Run a uiautomator dump before every adb call to dismiss system dialogs.
# Very expensive - leave off unless a device genuinely needs it.
ADB_AUTO_DISMISS_DIALOGS=false

# Floor for the /stream frame interval (ms).
STREAM_MIN_INTERVAL_MS=500

# Optional comma-separated DNS servers used when a proxy is set
EMULATOR_DNS=8.8.8.8,1.1.1.1
